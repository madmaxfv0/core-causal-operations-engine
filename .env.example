# CORE reads these from the environment. All are optional: with none set,
# CORE runs fully offline on the bundled synthetic data.
# Copy to .env and export, e.g.  set -a; source .env; set +a

# --- Where data lives -------------------------------------------------------
# CORE_DATA_DIR=./data

# --- Archive AI: who structures uploaded reports ------------------------------
# mock (default, rule-based, offline) | anthropic | openai | local
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
# LOCAL_LLM_MODEL=llama3

# Set to 1 to have the copilot's deterministic answer rephrased by Anthropic
# (needs ANTHROPIC_API_KEY). Numbers still come from the engine.
# COPILOT_LLM=0

# --- Optional operator telemetry gateway --------------------------------------
# SCADA_HTTP_URL=
# SCADA_PROVIDER=

# --- Running on a public link -------------------------------------------------
# 1 = refuse the endpoints that reset, rebuild, ingest or re-point shared data
# CORE_PUBLIC_DEMO=0
# Puts the whole app behind one shared password (HTTP Basic, any user name)
# CORE_ACCESS_PASSWORD=

# --- Overrides for the Alberta public-data sources ---------------------------
# AER_WELL_LICENCE_URL=
# AER_ABANDONED_URL=
# AER_CASING_FAILURES_URL=
# AER_VENT_FLOW_URL=
# AER_ST37_CRS=
